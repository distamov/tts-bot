# Шаблон конфигурации. Скопируйте в .env и заполните — .env в git не попадает.
#   cp .env.example .env      (Windows: copy .env.example .env)

# ---- Обязательное ----
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Ключ шифрования для API-ключей в БД.
# Сгенерировать: python scripts/genkey.py
ENCRYPTION_KEY=

# ---- Доступ ----
# Кому разрешено пользоваться ботом (Telegram user id через запятую).
# Пусто = доступ открыт всем (не рекомендуется: платит владелец ключа).
ALLOWED_USER_IDS=

# Кто может выполнять админ-команды (/stats). Через запятую.
ADMIN_USER_IDS=

# ---- Дефолты (можно не трогать) ----
# Ключ Fish Audio по умолчанию: подставляется новым пользователям,
# если они не задали свой через /setkey. Можно оставить пустым.
DEFAULT_FISH_API_KEY=
DEFAULT_FISH_MODEL=s2.1-pro-free
# reference_id голоса по умолчанию (пусто = дефолтный голос модели)
DEFAULT_FISH_VOICE_ID=

DB_PATH=data/bot.db
LOG_LEVEL=INFO
# Файл логов. Обязателен для фонового запуска (автозапуск Windows, pythonw):
# у такого процесса нет консоли, и без файла ошибки будет негде посмотреть.
# Пусто = только вывод в консоль. Ротация: 5 МБ, 3 архива.
LOG_FILE=

# Максимум символов в одном сообщении на озвучку
MAX_TEXT_CHARS=8000
